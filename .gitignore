*.vbs
.gitignore
# local tooling / scratch
.claude/
naukri_update/

# deps
node_modules/

# runtime flag: pauses automatic window hiding (created by show-windows.js)
.show-windows

# local backups
*.backup
*.before-*
*.pre-*
