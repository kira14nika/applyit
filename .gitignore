# secrets & personal data
.env

# runtime output
*.log
applications*.csv
apply-state-*.json
naukri-ledger.jsonl
naukri-deferred.jsonl
naukri-history.jsonl
profile.json
preferences.json
ai-state.json
runs/
archive/
*.png

# saved browser sessions (contain logged-in cookies)
.*-chrome-profile/
.*-apply-profile/

# resume / personal docs
*.pdf

